# пример для VPS. копирую в .env и меняю значения под себя

APP_NAME=MangalClubs Core
DEBUG=false

POSTGRES_DB=mangalclubs
POSTGRES_USER=mangalclubs
POSTGRES_PASSWORD=change-me-postgres-password

JWT_SECRET_KEY=change-me-long-random-secret
# CORS нужен для браузерного фронта/админки. обычное мобильное приложение сюда добавлять не надо
CORS_ORIGINS=https://example.ru,https://www.example.ru
PUBLIC_API_BASE_URL=https://api.example.ru

# домены, которые обслуживает Caddy. WEB_DIR - путь до frontend относительно этого проекта
DOMAIN=api.example.ru
WEB_DOMAIN=example.ru
WEB_DIR=../mangalclubs-web
API_BIND=127.0.0.1
API_PORT=8000
UVICORN_WORKERS=1

# public-переменные попадают в сборку Next.js. меняю их только вместе с пересборкой web
NEXT_PUBLIC_API_URL=https://api.example.ru
NEXT_PUBLIC_SITE_URL=https://example.ru

MEDIA_ROOT=/app/media
MEDIA_URL=/media
LOG_LEVEL=INFO
LOG_DIR=/app/logs
LOG_TO_FILE=true

# пока тестовый ключ T-Bank. потом меняю эти 2 строки на боевые
TBANK_API_BASE_URL=https://securepay.tinkoff.ru/v2
TBANK_DEFAULT_TERMINAL_KEY=put-test-terminal-key-here
TBANK_DEFAULT_PASSWORD=put-test-password-here
TBANK_NOTIFICATION_URL=
TBANK_SUCCESS_URL=
TBANK_FAIL_URL=
TBANK_PAID_STATUSES=CONFIRMED

COOKIE_SECURE=true

IIKO_API_BASE_URL=https://api-ru.iiko.services
IIKO_APP_ID=
IIKO_CLIENT_SECRET=

OTP_DELIVERY_PROVIDER=console
OTP_DEV_MODE=false
GREENSMS_AUTH_TOKEN=

GEOAPIFY_API_KEY=
YANDEX_MAPS_API_KEY=

BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

POSTGRES_MEMORY_LIMIT=512m
API_MEMORY_LIMIT=384m
WORKER_MEMORY_LIMIT=256m
BACKUP_MEMORY_LIMIT=128m
CADDY_MEMORY_LIMIT=128m
WEB_MEMORY_LIMIT=256m
