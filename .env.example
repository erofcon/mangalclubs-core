# Название приложения для OpenAPI-документации и логов.
APP_NAME='MangalClubs Core'
# Включает debug-режим для разработки. В production ставь false.
DEBUG=true

# Строка подключения SQLAlchemy async к PostgreSQL.
DATABASE_URL=postgresql+asyncpg://mangalclubs:mangalclubs_password@localhost:5432/mangalclubs
# Секрет для подписи JWT и хеширования refresh/OTP. Обязательно замени в каждом окружении.
JWT_SECRET_KEY=dev-secret-change-me-later
# Разрешенные browser origins для CORS через запятую.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Локальная папка для загруженных media-файлов.
MEDIA_ROOT=media
# Публичный URL-префикс для раздачи media-файлов.
MEDIA_URL=/media

# Logging.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_NAME=app.log
LOG_RETENTION_DAYS=14
LOG_TO_FILE=true

# Минимальный Android build, которому разрешено пользоваться API.
MOBILE_ANDROID_MIN_SUPPORTED_BUILD=1
# Последний Android build для подсказки мягкого обновления.
MOBILE_ANDROID_LATEST_BUILD=1
# Ссылка на магазин или обновление Android-приложения.
MOBILE_ANDROID_STORE_URL=
# Минимальный iOS build, которому разрешено пользоваться API.
MOBILE_IOS_MIN_SUPPORTED_BUILD=1
# Последний iOS build для подсказки мягкого обновления.
MOBILE_IOS_LATEST_BUILD=1
# Ссылка на магазин или обновление iOS-приложения.
MOBILE_IOS_STORE_URL=
# Заголовок обязательного обновления в мобильном приложении.
MOBILE_FORCE_UPDATE_TITLE=Обновите приложение
# Текст обязательного обновления в мобильном приложении.
MOBILE_FORCE_UPDATE_MESSAGE=Эта версия приложения больше не поддерживается. Пожалуйста, установите свежую версию, чтобы продолжить.
# Заголовок необязательного обновления в мобильном приложении.
MOBILE_SOFT_UPDATE_TITLE=Доступно обновление
# Текст необязательного обновления в мобильном приложении.
MOBILE_SOFT_UPDATE_MESSAGE=Вышла новая версия приложения. Обновитесь, когда будет удобно.

# Базовый URL для запросов к iiko API.
IIKO_API_BASE_URL=https://api-ru.iiko.services
# Как часто worker обновляет iiko access tokens, в секундах.
IIKO_AUTH_POLL_SECONDS=60
# Как часто worker обновляет меню iiko, в секундах.
IIKO_MENU_POLL_SECONDS=300
# За сколько секунд до истечения обновлять iiko token.
IIKO_TOKEN_REFRESH_MARGIN_SECONDS=120
# Timeout для HTTP-запросов к iiko, в секундах.
IIKO_REQUEST_TIMEOUT_SECONDS=10
# Таймзона для часов работы терминала и дат заказов.
IIKO_TERMINAL_TIMEZONE=Europe/Moscow
# Как часто worker повторяет отправку оплаченных заказов в iiko, в секундах.
IIKO_ORDER_DISPATCH_POLL_SECONDS=30
# Как часто worker опрашивает активные статусы заказов iiko, в секундах.
IIKO_ORDER_STATUS_POLL_SECONDS=15

# Публичный base URL API для сборки webhook URL, если отдельный URL не задан.
PUBLIC_API_BASE_URL=
# Базовый URL для T-Bank acquiring API.
TBANK_API_BASE_URL=https://securepay.tinkoff.ru/v2
# Timeout для HTTP-запросов к T-Bank, в секундах.
TBANK_REQUEST_TIMEOUT_SECONDS=10
# Как часто worker опрашивает незавершенные платежи T-Bank, в секундах.
TBANK_STATE_POLL_SECONDS=60
# T-Bank terminal key по умолчанию, если организация не переопределяет его.
TBANK_DEFAULT_TERMINAL_KEY=
# T-Bank terminal password по умолчанию, если организация не переопределяет его.
TBANK_DEFAULT_PASSWORD=
# Webhook URL для T-Bank. Если пусто, собирается из PUBLIC_API_BASE_URL.
TBANK_NOTIFICATION_URL=
# URL редиректа после успешной оплаты по умолчанию.
TBANK_SUCCESS_URL=
# URL редиректа после неуспешной оплаты по умолчанию.
TBANK_FAIL_URL=
# Статусы T-Bank, которые считаются оплаченной операцией, через запятую.
TBANK_PAID_STATUSES=CONFIRMED
# Сколько минут API дает на оплату неоплаченного заказа.
ORDER_UNPAID_PAYMENT_DEADLINE_MINUTES=20
# Через сколько минут worker помечает неоплаченную оплату/заказ истекшими.
ORDER_UNPAID_PAYMENT_TTL_MINUTES=30

# Опциональный GeoJSON Polygon/MultiPolygon вместо встроенной зоны доставки.
DELIVERY_AREA_GEOJSON=
# Geoapify API key для обратного геокодинга.
GEOAPIFY_API_KEY=
# Timeout для запросов к Geoapify, в секундах.
GEOAPIFY_REQUEST_TIMEOUT_SECONDS=3
# Timeout для запросов Expo push notifications, в секундах.
EXPO_PUSH_REQUEST_TIMEOUT_SECONDS=5

# Время жизни access token, в минутах.
ACCESS_TOKEN_MINUTES=15
# Время жизни refresh token, в днях.
REFRESH_TOKEN_DAYS=60

# Время жизни OTP-кода, в секундах.
OTP_TTL_SECONDS=300
# Базовая задержка перед повторным запросом OTP, в секундах.
OTP_RESEND_COOLDOWN_SECONDS=60
# Максимальное количество попыток проверки одного OTP.
OTP_MAX_ATTEMPTS=5
# Провайдер доставки OTP: console, greensms или call.
OTP_DELIVERY_PROVIDER=console
# Печатает OTP-коды в stdout для разработки. В production ставь false.
OTP_DEV_MODE=true
# Расписание cooldown для повторных OTP-запросов по телефону, в секундах.
OTP_PHONE_COOLDOWN_SCHEDULE_SECONDS=30,60,900
# Окно rate limit по телефону, в секундах.
OTP_PHONE_WINDOW_SECONDS=3600
# Максимум OTP-запросов на один телефон внутри OTP_PHONE_WINDOW_SECONDS.
OTP_PHONE_MAX_REQUESTS_PER_WINDOW=10
# Cooldown между OTP-запросами по IP, в секундах.
OTP_GLOBAL_COOLDOWN_SECONDS=30
# Окно rate limit по IP, в секундах.
OTP_IP_WINDOW_SECONDS=3600
# Максимум OTP-запросов на один IP внутри OTP_IP_WINDOW_SECONDS.
OTP_IP_MAX_REQUESTS_PER_WINDOW=10

# GreenSMS bearer token для доставки OTP через звонок/SMS.
GREENSMS_AUTH_TOKEN=
# Endpoint GreenSMS для отправки звонка.
GREENSMS_CALL_SEND_URL=https://api3.greensms.ru/call/send
# Timeout для запросов к GreenSMS, в секундах.
GREENSMS_REQUEST_TIMEOUT_SECONDS=10
# Включает voice call mode GreenSMS, если он поддерживается.
GREENSMS_CALL_VOICE=false
# Язык звонка GreenSMS.
GREENSMS_CALL_LANG=ru
# Tag GreenSMS для OTP-запросов.
GREENSMS_CALL_TAG=mangalclubs-auth

# Ставит Secure flag на refresh-token cookies. За HTTPS ставь true.
COOKIE_SECURE=false
